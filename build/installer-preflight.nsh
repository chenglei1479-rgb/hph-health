# #163: preflight that stops an install before anything is copied.
#
# A fresh install stalled at the progress bar and only then failed with "Baselio cannot be closed"
# (electron-builder's appCannotBeClosed, raised at the start of the install section). Two conditions were
# in play: the payload has files whose absolute path exceeds the Windows limit for the chosen folder,
# and the app can be running while the installer copies. Both checks below run before the first file is
# written, and both say what the user can do about it.
#
# The path budget is measured at packaging time (build/installer-path-budget.cjs, rewritten by the
# beforePack hook); this file only does arithmetic on it and shows one localized message.

!if /FileExists "${__FILEDIR__}\installer-path-budget.nsh"
  !include "${__FILEDIR__}\installer-path-budget.nsh"
!else
  !error "installer-path-budget.nsh is missing. It is generated by build/before-pack.cjs from the packaged payload (afterPack), so a build without it would ship an installer with the long-path preflight silently off. Run the packaging hook before compiling NSIS."
!endif

# Leave the installer after a preflight refusal. Nothing has been copied at this point, but customInit may
# already have moved a nested data root out of an old installation, so undo that first. Exit code 3 marks
# a preflight refusal for the packaged smoke test and for support.
!macro baselioRefuseBeforeCopy REASON
  DetailPrint "Baselio install preflight refused: ${REASON}"
  !ifmacrodef restoreAllNestedDataRoots
    !insertmacro restoreAllNestedDataRoots
  !endif
  SetErrorLevel 3
  Quit
!macroend

# Refuses a target folder where any payload file would exceed the limit. $R1/$R3/$R4 are read by the
# localized message, so they must still hold their values when MessageBox returns.
!macro baselioPreflightInstallPath
  !ifdef BASELIO_MAX_RELATIVE_PATH
    StrLen $R1 "$INSTDIR"
    # The message reads these numbers from registers, not from the generated defines, so the installer
    # strings compile on their own (the packaging tests extract macros without the budget include).
    StrCpy $R2 ${BASELIO_PATH_LIMIT}
    StrCpy $R5 ${BASELIO_MAX_INSTALL_DIR_LENGTH}
    !insertmacro baselioCountOverflowingFiles
    ${If} $R3 > 0
      IntOp $R4 $R1 + ${BASELIO_MAX_RELATIVE_PATH}
      MessageBox MB_ICONSTOP|MB_OK "$(BaselioPreflightPathTooLong)" /SD IDOK
      !insertmacro baselioRefuseBeforeCopy "path-too-long"
    ${EndIf}
  !endif
!macroend

# Refuses a fresh install while the app is running, and names the process and the next step. An in-app
# update installs while the app is opening the installer on purpose; electron-builder's own
# CHECK_APP_RUNNING closes it there, so this preflight stays out of that path (a registered installation
# in either hive means update).
!macro baselioPreflightRunningApp
  !ifmacrodef FIND_PROCESS
    ${If} $perMachineInstallDirCache == ""
    ${AndIf} $perUserInstallDirCache == ""
      !insertmacro FIND_PROCESS "${APP_EXECUTABLE_FILENAME}" $R0
      ${If} $R0 == 0
        MessageBox MB_ICONSTOP|MB_OK "$(BaselioPreflightAppRunning)" /SD IDOK
        !insertmacro baselioRefuseBeforeCopy "app-running"
      ${EndIf}
    ${EndIf}
  !endif
!macroend
