# #163: preflight that stops an install before anything is copied.
#
# A fresh install stalled at the progress bar and only then failed with "Baselio cannot be closed"
# (electron-builder's appCannotBeClosed, raised at the start of the install section). Two conditions were
# in play: the payload has files whose absolute path exceeds the Windows limit for the chosen folder,
# and the app can be running while the installer copies. Both checks below run before the first file is
# written, and both say what the user can do about it.
#
# The path budget is measured at packaging time (build/installer-path-budget.cjs, rewritten by the
# beforePack hook); this file only does arithmetic on it and shows one localized message.
#
# A refusal also writes one line to %TEMP%\Baselio-install-preflight.log. Measured with this toolchain:
# a silent install (/S) shows no dialog AND writes nothing to stdout or stderr (a probe printing
# DetailPrint and exiting 3 produced 0 bytes on both streams), so exit code 3 on its own is
# indistinguishable from a crash. The line is English with stable ids (reason=..., action=...) because it
# is read by whoever handles the report, not by the UI language.

!if /FileExists "${__FILEDIR__}\installer-path-budget.nsh"
  !include "${__FILEDIR__}\installer-path-budget.nsh"
!else
  !error "installer-path-budget.nsh is missing. It is generated by build/before-pack.cjs from the packaged payload (afterPack), so a build without it would ship an installer with the long-path preflight silently off. Run the packaging hook before compiling NSIS."
!endif

# Leave the installer after a preflight refusal. Nothing has been copied at this point, but customInit may
# already have moved a nested data root out of an old installation, so undo that first. Exit code 3 marks
# a preflight refusal for the packaged smoke test and for support.
!macro baselioRefuseBeforeCopy REASON
  DetailPrint "Baselio install preflight refused: ${REASON}"
  !ifmacrodef restoreAllNestedDataRoots
    !insertmacro restoreAllNestedDataRoots
  !endif
  SetErrorLevel 3
  Quit
!macroend

!define BASELIO_PREFLIGHT_LOG "Baselio-install-preflight.log"

# Appends one line to the refusal log. %TEMP% first (always exists for the installing user), then the
# installer's own folder for a deployment where TEMP is read-only. A log that cannot be written must never
# change the verdict or the exit code, so every failure here is cleared and ignored.
!macro baselioLogPreflightRefusal LINE
  Push $R6
  Push $R7
  StrCpy $R7 "0"
  ${IfNot} ${FileExists} "$TEMP\${BASELIO_PREFLIGHT_LOG}"
    StrCpy $R7 "1"
  ${EndIf}
  ClearErrors
  # Mode "a" does not seek on this NSIS (v3.04): the handle starts at offset 0, so without the explicit
  # FileSeek each refusal overwrote the previous one and the log kept only the last attempt.
  FileOpen $R6 "$TEMP\${BASELIO_PREFLIGHT_LOG}" a
  ${If} ${Errors}
    # The fallback exists for the case where TEMP cannot be written, so it must produce the same readable
    # file: decide the byte-order mark for THIS path again instead of carrying the TEMP path's verdict. A
    # fallback file without the mark reads as mojibake in exactly the situation it was added for.
    StrCpy $R7 "0"
    ${IfNot} ${FileExists} "$EXEDIR\${BASELIO_PREFLIGHT_LOG}"
      StrCpy $R7 "1"
    ${EndIf}
    ClearErrors
    FileOpen $R6 "$EXEDIR\${BASELIO_PREFLIGHT_LOG}" a
  ${EndIf}
  ${IfNot} ${Errors}
    FileSeek $R6 0 END
    ${If} $R7 == "1"
      # UTF-16LE byte-order mark on the first line only, matching what FileWriteUTF16LE writes.
      FileWriteByte $R6 0xFF
      FileWriteByte $R6 0xFE
    ${EndIf}
    FileWriteUTF16LE $R6 "${LINE}$\r$\n"
    FileClose $R6
  ${EndIf}
  ClearErrors
  Pop $R7
  Pop $R6
!macroend

# Refuses a target folder where any payload file would exceed the limit. $R1/$R3/$R4 are read by the
# localized message, so they must still hold their values when MessageBox returns.
!macro baselioPreflightInstallPath
  !ifdef BASELIO_MAX_RELATIVE_PATH
    StrLen $R1 "$INSTDIR"
    # The message reads these numbers from registers, not from the generated defines, so the installer
    # strings compile on their own (the packaging tests extract macros without the budget include).
    StrCpy $R2 ${BASELIO_PATH_LIMIT}
    StrCpy $R5 ${BASELIO_MAX_INSTALL_DIR_LENGTH}
    !insertmacro baselioCountOverflowingFiles
    ${If} $R3 > 0
      IntOp $R4 $R1 + ${BASELIO_MAX_RELATIVE_PATH}
      # Logged before the dialog so the numbers survive a user who dismisses it.
      !insertmacro baselioLogPreflightRefusal "refusal reason=path-too-long folder-length=$R1 overflowing-files=$R3 longest-path=$R4 limit=$R2 longest-usable-folder=$R5 install-folder=$\"$INSTDIR$\" action=rerun-the-installer-with-a-shorter-folder"
      MessageBox MB_ICONSTOP|MB_OK "$(BaselioPreflightPathTooLong)" /SD IDOK
      !insertmacro baselioRefuseBeforeCopy "path-too-long"
    ${EndIf}
  !endif
!macroend

# Refuses a fresh install while the app is running, and names the process and the next step. An in-app
# update installs while the app is opening the installer on purpose; electron-builder's own
# CHECK_APP_RUNNING closes it there, so this preflight stays out of that path. The exemption needs a
# registered location AND the executable still present: an unclean uninstall leaves InstallLocation behind,
# and trusting the mere value let a fresh install into a stale folder skip this check and reach the stall
# this ticket is about.
#
# The lookup is ours, not electron-builder's FIND_PROCESS. That macro reads $IsPowerShellAvailable,
# $PowerShellPath and $CmdPath, and CHECK_APP_RUNNING declares all three. The assembled script inserts
# customInit in .onInit (installer.nsi) and CHECK_APP_RUNNING only later, from installSection.nsh, so a
# reference here expands before the declaration: makensis emits `warning 6000: unknown variable/constant
# "IsPowerShellAvailable"` and electron-builder compiles with -WX, which failed the whole Windows build
# (release blocker: no installer could be produced). This calls the nsProcess plugin instead - the same
# plugin electron-builder itself uses for the checks - which needs no globals and answers in ~0.3 s,
# where a tasklist pipeline through nsExec::Exec measured ~20 s here. A probe may define
# baselioFindRunningProcess before including the file to simulate a running app.
!ifndef nsProcess::FindProcess
  # electron-builder already adds its include directory before this file is included.
  !include "nsProcess.nsh"
!endif

!ifmacrondef baselioFindRunningProcess
!macro baselioFindRunningProcess _RETURN
  # `!insertmacro` targets the macro in nsProcess.nsh; the bare `nsProcess::FindProcess` form is parsed as
  # a plugin function and fails with "Plugin function not found".
  !insertmacro nsProcess::FindProcess `${APP_EXECUTABLE_FILENAME}` ${_RETURN}
!macroend
!endif

!macro baselioPreflightRunningApp
  # $R8 = 1 when a registered installation really is on disk (update), so the check below is skipped.
  StrCpy $R8 "0"
  ${If} $perMachineInstallDirCache != ""
    ${If} ${FileExists} "$perMachineInstallDirCache\${APP_EXECUTABLE_FILENAME}"
      StrCpy $R8 "1"
    ${EndIf}
  ${EndIf}
  ${If} $perUserInstallDirCache != ""
    ${If} ${FileExists} "$perUserInstallDirCache\${APP_EXECUTABLE_FILENAME}"
      StrCpy $R8 "1"
    ${EndIf}
  ${EndIf}
  ${If} $R8 == "0"
    !insertmacro baselioFindRunningProcess $R0
    ${If} $R0 == 0
      !insertmacro baselioLogPreflightRefusal "refusal reason=app-running process=${APP_EXECUTABLE_FILENAME} install=fresh action=quit-Baselio-then-rerun-the-installer"
      MessageBox MB_ICONSTOP|MB_OK "$(BaselioPreflightAppRunning)" /SD IDOK
      !insertmacro baselioRefuseBeforeCopy "app-running"
    ${EndIf}
  ${EndIf}
!macroend
